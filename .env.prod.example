# Configuración de Producción para NexoPOS

# Base de Datos (PostgreSQL)
POSTGRES_USER=nexopos_user
POSTGRES_PASSWORD=una_contrasenia_segura_aqui
POSTGRES_DB=nexopos_prod

# URL de la base de datos para la API
# Nota: 'postgres' es el nombre del servicio en docker-compose.prod.yml
DATABASE_URL=postgresql://${POSTGRES_USER}:${POSTGRES_PASSWORD}@postgres:5432/${POSTGRES_DB}

# Autenticación
JWT_SECRET=un_secreto_muy_largo_y_aleatorio_generado_en_produccion

# Frontend
# Usamos '/api' para que el proxy de Nginx redirija las peticiones al contenedor de la API
VITE_API_URL=/api

# Puerto de la API (Interno al contenedor)
PORT=3000
