# Modo simulador (true = sin hardware, para desarrollo/QA)
MOCK_MODE=true

# Puerto COM del terminal Transbank (Windows: COM3, COM4...; Linux: /dev/ttyUSB0)
COM_PORT=COM3

# Velocidad de comunicación (por defecto 115200)
BAUD_RATE=115200

# Puerto HTTP del agente (el frontend lo llama en localhost:7777)
PORT=7777

# Solo en MOCK_MODE: escenario a simular (approved | rejected | timeout)
MOCK_SCENARIO=approved

# Demora simulada en ms (simula el tiempo real de inserción de tarjeta)
MOCK_DELAY_MS=3000
