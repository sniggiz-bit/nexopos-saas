# Build stage
FROM node:20-alpine AS builder

WORKDIR /app
# Use the reviewed workspace lockfile so releases resolve identical dependencies.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
ENV NODE_ENV=development
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci

# Vite resolves the shared workspace through its local source alias.
COPY packages/shared ./packages/shared
WORKDIR /app/apps/web

# Copy source files
COPY apps/web/src ./src
COPY apps/web/config ./config
COPY apps/web/public ./public
COPY apps/web/index.html apps/web/vite.config.ts apps/web/tailwind.config.js apps/web/postcss.config.js ./
COPY apps/web/tsconfig.json apps/web/tsconfig.app.json apps/web/tsconfig.node.json ./

COPY apps/print-agent /app/apps/print-agent
RUN node /app/apps/print-agent/package.cjs

# Skip tsc type-check; vite uses esbuild for TS transpilation
RUN npm exec -- vite build

# Production stage (Nginx)
FROM nginx:alpine AS runner

# Copy build artifacts to nginx public directory
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Route-aware public SEO and protected application routing.
COPY apps/web/nginx.conf /etc/nginx/conf.d/default.conf
RUN nginx -t

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
