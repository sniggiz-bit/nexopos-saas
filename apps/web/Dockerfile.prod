# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace files
COPY package.json package-lock.json ./
# Copy all workspace package.json files so npm workspaces resolves correctly
COPY apps/web/package.json ./apps/web/
COPY apps/api/package.json ./apps/api/
COPY packages/shared/package.json ./packages/shared/

# Install all deps — force devDependencies regardless of NODE_ENV
RUN npm install --include=dev

# Copy the rest of the application
COPY apps/web ./apps/web
COPY packages/shared ./packages/shared

# Run build from workspace root so npm sets up PATH with all node_modules/.bin correctly
WORKDIR /app
RUN npm run build -w apps/web

# Production stage (Nginx)
FROM nginx:alpine AS runner

# Copy build artifacts to nginx public directory
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Custom nginx configuration for SPA routing and Gzip
RUN echo 'server { \
    listen 80; \
    server_name localhost; \
    root /usr/share/nginx/html; \
    index index.html; \
    gzip on; \
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript; \
    location / { \
    try_files $uri $uri/ /index.html; \
    } \
    location = /index.html { \
    add_header Cache-Control "no-store, no-cache, must-revalidate"; \
    } \
    location /api { \
    proxy_pass http://api:3000; \
    proxy_http_version 1.1; \
    proxy_set_header Upgrade $http_upgrade; \
    proxy_set_header Connection "upgrade"; \
    proxy_set_header Host $host; \
    proxy_cache_bypass $http_upgrade; \
    } \
    }' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
