# Build stage
FROM node:20-alpine AS builder

# Copy shared package — vite aliases @nexopos/shared to this local path
COPY packages/shared /app/packages/shared

# Install web app deps in isolation (no workspace hoisting issues)
WORKDIR /app/apps/web
COPY apps/web/package.json ./

# Remove @nexopos/shared workspace dep; vite resolves it via local alias in vite.config.ts
RUN node -e "const fs=require('fs'); const p=JSON.parse(fs.readFileSync('package.json','utf8')); delete p.dependencies['@nexopos/shared']; fs.writeFileSync('package.json',JSON.stringify(p,null,2));"

ENV NODE_ENV=development
RUN --mount=type=cache,target=/root/.npm npm install

# Copy source files
COPY apps/web/src ./src
COPY apps/web/public ./public
COPY apps/web/index.html apps/web/vite.config.ts apps/web/tailwind.config.js apps/web/postcss.config.js ./
COPY apps/web/tsconfig.json apps/web/tsconfig.app.json apps/web/tsconfig.node.json ./

# Skip tsc type-check; vite uses esbuild for TS transpilation
RUN ./node_modules/.bin/vite build

# Production stage (Nginx)
FROM nginx:alpine AS runner

# Copy build artifacts to nginx public directory
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Nginx config: SPA routing + API proxy with SSE support
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location = /index.html {\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate";\n\
    }\n\
\n\
    resolver 127.0.0.11 valid=30s ipv6=off;\n\
\n\
    # SSE endpoint: disable buffering so events stream immediately to the browser\n\
    location /api/events/stream {\n\
        set $api_upstream api;\n\
        proxy_pass http://$api_upstream:3000;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header Connection "";\n\
        proxy_buffering off;\n\
        proxy_cache off;\n\
        proxy_read_timeout 86400s;\n\
        chunked_transfer_encoding on;\n\
    }\n\
\n\
    # General API proxy (WebSocket + REST)\n\
    location /api {\n\
        set $api_upstream api;\n\
        proxy_pass http://$api_upstream:3000;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_cache_bypass $http_upgrade;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
