# Build stage
FROM node:20-alpine AS builder

WORKDIR /app
# Use the reviewed workspace lockfile so releases resolve identical dependencies.
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/
ENV NODE_ENV=development
ENV PUPPETEER_SKIP_DOWNLOAD=true
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci

# Vite resolves the shared workspace through its local source alias.
COPY packages/shared ./packages/shared
WORKDIR /app/apps/web

# Copy source files
COPY apps/web/src ./src
COPY apps/web/public ./public
COPY apps/web/index.html apps/web/vite.config.ts apps/web/tailwind.config.js apps/web/postcss.config.js ./
COPY apps/web/tsconfig.json apps/web/tsconfig.app.json apps/web/tsconfig.node.json ./

COPY apps/print-agent /app/apps/print-agent
RUN node /app/apps/print-agent/package.cjs

# Skip tsc type-check; vite uses esbuild for TS transpilation
RUN npm exec -- vite build

# Production stage (Nginx)
FROM nginx:alpine AS runner

# Copy build artifacts to nginx public directory
COPY --from=builder /app/apps/web/dist /usr/share/nginx/html

# Nginx config: SPA routing + API proxy with SSE support
RUN printf 'server {\n\
    listen 80;\n\
    server_name localhost;\n\
    root /usr/share/nginx/html;\n\
    index index.html;\n\
\n\
    gzip on;\n\
    gzip_types text/plain text/css application/json application/javascript text/xml application/xml application/xml+rss text/javascript;\n\
\n\
    location / {\n\
        try_files $uri $uri/ /index.html;\n\
    }\n\
\n\
    location = /index.html {\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate";\n\
    }\n\
\n\
    # Update metadata must be revalidated, including by already installed clients.\n\
    location = /manifest.webmanifest {\n\
        default_type application/manifest+json;\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;\n\
    }\n\
    location = /sw.js {\n\
        add_header Cache-Control "no-store, no-cache, must-revalidate" always;\n\
    }\n\
\n\
    # Static assets caching\n\
    location ~* \\.(?:css|js|jpg|jpeg|gif|png|ico|cur|gz|svg|svgz|mp4|ogg|ogv|webm|htc|webp|woff|woff2|ttf|eot)$ {\n\
        expires 1y;\n\
        add_header Cache-Control "public, max-age=31536000, immutable";\n\
        access_log off;\n\
    }\n\
\n\
    resolver 127.0.0.11 valid=30s ipv6=off;\n\
\n\
    # SSE endpoint: disable buffering so events stream immediately to the browser\n\
    location ^~ /api/events/stream {\n\
        set $api_upstream api;\n\
        proxy_pass http://$api_upstream:3000;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Host $host;\n\
        proxy_set_header Connection "";\n\
        proxy_buffering off;\n\
        proxy_cache off;\n\
        proxy_read_timeout 86400s;\n\
        chunked_transfer_encoding on;\n\
    }\n\
\n\
    # Socket.IO transport for the /events namespace\n\
    location ^~ /socket.io/ {\n\
        set $api_upstream api;\n\
        proxy_pass http://$api_upstream:3000;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_buffering off;\n\
        proxy_read_timeout 3600s;\n\
    }\n\
\n\
    # General API proxy (WebSocket + REST)\n\
    location ^~ /api {\n\
        set $api_upstream api;\n\
        proxy_pass http://$api_upstream:3000;\n\
        proxy_http_version 1.1;\n\
        proxy_set_header Upgrade $http_upgrade;\n\
        proxy_set_header Connection "upgrade";\n\
        proxy_set_header Host $host;\n\
        proxy_cache_bypass $http_upgrade;\n\
    }\n\
}\n' > /etc/nginx/conf.d/default.conf

EXPOSE 80

CMD ["nginx", "-g", "daemon off;"]
