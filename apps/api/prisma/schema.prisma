generator client {
  provider = "prisma-client-js"
  engineType = "library"
}


datasource db {
  provider = "postgresql"
}

model Tenant {
  id            String          @id @default(uuid())
  name          String
  slug          String          @unique
  phone         String?
  rut           String?
  giro          String?
  address       String?
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt
  branches      Branch[]
  brands        Brand[]
  categories    Category[]
  dteConfig     DteConfig?
  products      Product[]
  sales         Sale[]
  users         User[]
  customers     Customer[]
  quotes        Quote[]
  credits       Credit[]
  planId        String?
  plan          Plan?           @relation(fields: [planId], references: [id])
  status        String          @default("ACTIVE") // ACTIVE, SUSPENDED
  nextPayment   DateTime?
  storeSlug     String?         @unique
  storeSettings Json?
  systemLogs    SystemLog[]
  settings      TenantSettings?
}

model Branch {
  id             String           @id @default(uuid())
  name           String
  address        String?
  isMain         Boolean          @default(false)
  isActive       Boolean          @default(false)
  tenantId       String
  createdAt      DateTime         @default(now())
  updatedAt      DateTime         @updatedAt @default(now())
  tenant         Tenant           @relation(fields: [tenantId], references: [id])
  inventory      Inventory[]
  sales          Sale[]
  users          User[]
  cashShifts     CashShift[]
  stockMovements StockMovement[]
  transfersFrom  Transfer[]       @relation("OriginBranch")
  transfersTo    Transfer[]       @relation("DestinationBranch")
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  role      UserRole @default(USER)
  tenantId  String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  branch    Branch?  @relation(fields: [branchId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]
  shiftsOpened CashShift[] @relation("OpenedShifts")
  shiftsClosed CashShift[] @relation("ClosedShifts")
  requestedTransfers Transfer[] @relation("RequestedBy")
  processedTransfers Transfer[] @relation("ProcessedBy")
  quotes    Quote[]
}

enum UserRole {
  ADMIN
  CASHIER
  USER
  SUPER_ADMIN
}

model Category {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([name, tenantId])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([name, tenantId])
}

model Product {
  id         String           @id @default(uuid())
  name       String
  sku        String?
  price      Int              @default(0)
  tenantId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  barcode    String?
  brandId    String?
  categoryId String?
  costPrice  Int              @default(0)
  image      String?
  description String?
  isPublic   Boolean          @default(false)
  isActive   Boolean          @default(true)
  minStock   Int              @default(0) // Global minStock, deprecated in favor of Inventory.minStock
  stock      Int?             // @deprecated - Used for migration only
  unitType   UnitType         @default(UNIT)
  inventory  Inventory[]
  brand      Brand?           @relation(fields: [brandId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  saleItems  SaleItem[]
  quoteItems QuoteItem[]
  stockMovements StockMovement[]
  transferItems TransferItem[]

  @@unique([barcode, tenantId])
}

model Inventory {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  quantity  Decimal  @default(0) @db.Decimal(10, 3)
  minStock  Int      @default(0)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
  @@map("InventoryLevel")
}

model Transfer {
  id              String         @id @default(uuid())
  originBranchId  String
  destBranchId    String
  status          TransferStatus @default(PENDING)
  requestedById   String
  processedById   String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  note            String?

  originBranch    Branch         @relation("OriginBranch", fields: [originBranchId], references: [id])
  destinationBranch Branch       @relation("DestinationBranch", fields: [destBranchId], references: [id])
  requestedBy     User           @relation("RequestedBy", fields: [requestedById], references: [id])
  processedBy     User?          @relation("ProcessedBy", fields: [processedById], references: [id])
  items           TransferItem[]
}

model TransferItem {
  id          String   @id @default(uuid())
  transferId  String
  productId   String
  quantity    Decimal  @db.Decimal(10, 3)
  
  transfer    Transfer @relation(fields: [transferId], references: [id])
  product     Product  @relation(fields: [productId], references: [id])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Sale {
  id                 String     @id @default(uuid())
  total              Float
  tenantId           String
  branchId           String
  userId             String?
  cashShiftId        String?
  customerId         String?
  quoteId            String?
  status             String     @default("COMPLETED") // COMPLETED, PRE_SALE
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  dteFolio           Int?
  dteStatus          String     @default("PENDING")
  dteType            Int        @default(39)
  dtePdfUrl          String?
  internalReceiptUrl String?
  branch             Branch     @relation(fields: [branchId], references: [id])
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  user               User?      @relation(fields: [userId], references: [id])
  cashShift          CashShift? @relation(fields: [cashShiftId], references: [id])
  customer           Customer?  @relation(fields: [customerId], references: [id])
  quote              Quote?     @relation(fields: [quoteId], references: [id])
  credit             Credit?
  items              SaleItem[]
  payments           Payment[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  amount        Float
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id])
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

model DteConfig {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  liorenToken    String?
  liorenLogo     String?
  dteResolution  String?
  resolutionDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

enum UnitType {
  UNIT
  WEIGHT
}

model CashShift {
  id            String    @id @default(uuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  openedById    String
  openedBy      User      @relation("OpenedShifts", fields: [openedById], references: [id])
  closedById    String?
  closedBy      User?     @relation("ClosedShifts", fields: [closedById], references: [id])
  startTime     DateTime  @default(now())
  endTime       DateTime?
  initialAmount Decimal   @db.Decimal(10, 2)
  finalAmount   Decimal?  @db.Decimal(10, 2)
  expectedAmount Decimal? @db.Decimal(10, 2)
  difference    Decimal?  @db.Decimal(10, 2)
  status        String    @default("OPEN")
  metadata      Json?
  sales          Sale[]
  creditPayments CreditPayment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  rut       String
  giro      String?
  address   String?
  comuna    String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sales     Sale[]
  quotes    Quote[]
  credits   Credit[]
  
  @@unique([rut, tenantId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id         String      @id @default(uuid())
  number     String?     // e.g. QT-0001
  tenantId   String
  customerId String?
  userId     String?
  subtotal   Float       @default(0)
  tax        Float       @default(0)
  total      Float       @default(0)
  status     QuoteStatus @default(DRAFT)
  issueDate  DateTime    @default(now())
  validUntil DateTime?
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  
  items      QuoteItem[]
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  user       User?       @relation(fields: [userId], references: [id])
  sales      Sale[]
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  productId   String
  productName String? // Keep name for history
  quantity    Decimal @db.Decimal(10, 3)
  price       Float
  discount    Float   @default(0)
  total       Float
  
  quote       Quote   @relation(fields: [quoteId], references: [id])
  product     Product @relation(fields: [productId], references: [id])
}

model Credit {
  id          String          @id @default(uuid())
  tenantId    String
  customerId  String
  saleId      String?         @unique
  totalAmount Float
  balance     Float
  status      String          @default("OPEN") // OPEN, PAID
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  sale        Sale?           @relation(fields: [saleId], references: [id])
  payments    CreditPayment[]
}

model CreditPayment {
  id            String    @id @default(uuid())
  creditId      String
  amount        Float
  paymentMethod String
  cashShiftId   String?
  createdAt     DateTime  @default(now())
  credit        Credit    @relation(fields: [creditId], references: [id])
  cashShift     CashShift? @relation(fields: [cashShiftId], references: [id])
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  branchId  String
  quantity  Decimal      @db.Decimal(10, 3) // Positive for IN, Negative for OUT
  type      MovementType
  reference String?      // e.g. "SALE-123" or "Initial Stock"
  balance   Decimal      @db.Decimal(10, 3) // Calculated balance after this movement
  createdAt DateTime     @default(now())
  userId    String?

  product   Product      @relation(fields: [productId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL
}

model Plan {
  id          String   @id @default(uuid())
  name        String
  description String?
  price       Int
  features    Json?    // Array of benefit strings
  maxUsers    Int
  maxProducts Int
  maxStorage  Int      @default(0) // In MB
  isRecommended Boolean @default(false)
  isVisible   Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  tenants     Tenant[]
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String   // ERROR, WARNING, INFO
  message   String
  context   Json?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String   // INFO, WARNING
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // --- Módulos DTE (SII chileno) ---
  enableBoletaDte       Boolean @default(false)
  enableFacturaDte      Boolean @default(false)
  enableGuiaDespachoDte Boolean @default(false)
  enableNotaCreditoDte  Boolean @default(false)

  // --- Límites de Recursos ---
  maxBranches  Int @default(1)
  maxRegisters Int @default(1)
  maxUsers     Int @default(3)

  // --- Permisos Especiales ---
  canHardDelete Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}
