// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// Enum for product unit types (unit-based or weight-based sales)
enum UnitType {
  UNIT    // Sold by unit (e.g., bottles, boxes)
  WEIGHT  // Sold by weight (e.g., kg, grams) - allows decimal quantities
}

model Tenant {
  id        String   @id @default(uuid())
  name      String
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  users      User[]
  branches   Branch[]
  products   Product[]
  sales      Sale[]
  categories Category[]
  brands     Brand[]
  dteConfig  DteConfig?
}

model Branch {
  id        String   @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  
  users     User[]
  inventory InventoryLevel[]
  sales     Sale[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String?
  branch    Branch?  @relation(fields: [branchId], references: [id])

  sales     Sale[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model Category {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@unique([name, tenantId])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  
  @@unique([name, tenantId])
}

model Product {
  id         String    @id @default(uuid())
  name       String
  sku        String?
  barcode    String?   // Product barcode (unique per tenant)
  price      Int       @default(0) // Selling price in Chilean Pesos (CLP)
  costPrice  Int       @default(0) // Cost price for margin calculations
  minStock   Int       @default(0) // Minimum stock level for alerts
  unitType   UnitType  @default(UNIT) // UNIT or WEIGHT
  image      String?   // URL to product image
  isActive   Boolean   @default(true) // Soft delete support
  
  tenantId   String
  tenant     Tenant    @relation(fields: [tenantId], references: [id])
  categoryId String?
  category   Category? @relation(fields: [categoryId], references: [id])
  brandId    String?
  brand      Brand?    @relation(fields: [brandId], references: [id])
  
  inventory  InventoryLevel[]
  saleItems  SaleItem[]

  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt
  
  @@unique([barcode, tenantId])
}

model InventoryLevel {
  id        String   @id @default(uuid())
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  quantity  Decimal  @default(0) @db.Decimal(10, 3) // Supports decimal quantities (e.g., 0.5 kg)

  updatedAt DateTime @updatedAt

  @@unique([productId, branchId])
}

model Sale {
  id            String   @id @default(uuid())
  total         Float
  paymentMethod String   // "CASH", "CARD", "TRANSFER", "DEBIT"
  
  tenantId  String
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  branchId  String
  branch    Branch   @relation(fields: [branchId], references: [id])
  userId    String?
  user      User?    @relation(fields: [userId], references: [id])

  items     SaleItem[]

  // DTE (Documento Tributario Electrónico) fields for Chilean tax compliance
  dteType   Int     @default(39) // 39 = Boleta Electrónica
  dteFolio  Int?    // Assigned by SII when DTE is emitted
  dteStatus String  @default("PENDING") // PENDING, ACEPTADO, RECHAZADO
  dtePdfUrl String? // URL to the PDF version of the DTE from Lioren

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SaleItem {
  id        String   @id @default(uuid())
  saleId    String
  sale      Sale     @relation(fields: [saleId], references: [id])
  productId String
  product   Product  @relation(fields: [productId], references: [id])
  
  quantity  Decimal  @db.Decimal(10, 3) // Supports decimal quantities for bulk sales
  price     Float
}

model DteConfig {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
  liorenToken    String?   // API token for Lioren DTE service
  liorenLogo     String?   // URL to company logo for DTE
  dteResolution  String?   // SII resolution number
  resolutionDate DateTime? // Date of SII resolution
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
}
