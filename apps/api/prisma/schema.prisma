generator client {
  provider        = "prisma-client-js"
  engineType      = "library"
  binaryTargets   = ["native", "rhel-openssl-1.1.x", "debian-openssl-1.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Tenant {
  id                    String                @id @default(uuid())
  name                  String
  slug                  String                @unique
  phone                 String?
  rut                   String?
  giro                  String?
  address               String?
  logoUrl               String?
  createdAt             DateTime              @default(now())
  updatedAt             DateTime              @updatedAt
  branches              Branch[]
  brands                Brand[]
  categories            Category[]
  dteConfig             DteConfig?
  products              Product[]
  sales                 Sale[]
  users                 User[]
  customers             Customer[]
  quotes                Quote[]
  credits               Credit[]
  planId                String?
  plan                  Plan?                 @relation(fields: [planId], references: [id])
  status                String                @default("ACTIVE") // ACTIVE, SUSPENDED
  nextPayment           DateTime?
  storeSlug             String?               @unique
  storeSettings         Json?
  systemLogs            SystemLog[]
  settings              TenantSettings?
  suppliers             Supplier[]
  purchases             Purchase[]
  transbankTransactions PaymentTransaction[]
  ecommerceConnections  EcommerceConnection[]
  ecommerceOrders       EcommerceOrder[]
  tenantModuleAddons    TenantModuleAddon[]
  billingStatus         BillingStatus         @default(ACTIVE)
  invoices              Invoice[]
}

enum BillingStatus {
  ACTIVE
  PAST_DUE
  CANCELED
}

model Invoice {
  id        String   @id @default(uuid())
  tenantId  String
  amount    Float
  status    String   @default("PENDING") // PENDING, PAID, FAILED
  dueDate   DateTime
  paidAt    DateTime?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id], onDelete: Cascade)

  @@index([tenantId])
}

model Branch {
  id                    String               @id @default(uuid())
  name                  String
  address               String?
  isMain                Boolean              @default(false)
  isActive              Boolean              @default(false)
  tenantId              String
  transbankSettings     Json?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @default(now()) @updatedAt
  tenant                Tenant               @relation(fields: [tenantId], references: [id])
  inventory             Inventory[]
  sales                 Sale[]
  users                 User[]
  cashShifts            CashShift[]
  stockMovements        StockMovement[]
  transfersFrom         Transfer[]           @relation("OriginBranch")
  transfersTo           Transfer[]           @relation("DestinationBranch")
  purchases             Purchase[]
  transbankTransactions PaymentTransaction[]

  @@index([tenantId])
}

model User {
  id                 String          @id @default(uuid())
  email              String          @unique
  name               String?
  password           String?
  role               UserRole        @default(MANAGER)
  tenantId           String
  branchId           String?
  createdAt          DateTime        @default(now())
  updatedAt          DateTime        @updatedAt
  sales              Sale[]
  branch             Branch?         @relation(fields: [branchId], references: [id])
  tenant             Tenant          @relation(fields: [tenantId], references: [id])
  stockMovements     StockMovement[]
  shiftsOpened       CashShift[]     @relation("OpenedShifts")
  shiftsClosed       CashShift[]     @relation("ClosedShifts")
  requestedTransfers Transfer[]      @relation("RequestedBy")
  processedTransfers Transfer[]      @relation("ProcessedBy")
  quotes             Quote[]

  @@index([tenantId])
  @@index([branchId])
}

enum UserRole {
  TENANT_ADMIN
  CASHIER
  MANAGER
  SUPER_ADMIN
}

model Category {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([name, tenantId])
  @@index([tenantId])
}

model Product {
  id                String             @id @default(uuid())
  name              String
  sku               String?
  price             Int                @default(0)
  tenantId          String
  createdAt         DateTime           @default(now())
  updatedAt         DateTime           @updatedAt
  barcode           String?
  brandId           String?
  categoryId        String?
  costPrice         Int                @default(0)
  image             String?
  galleryImages     String[]           @default([])
  description       String?
  isPublic          Boolean            @default(false)
  isActive          Boolean            @default(true)
  minStock          Int                @default(0) // Global minStock, deprecated in favor of Inventory.minStock
  stock             Int? // @deprecated - Used for migration only
  unitType          UnitType           @default(UNIT)
  inventory         Inventory[]
  supplierId        String?
  supplier          Supplier?          @relation(fields: [supplierId], references: [id])
  brand             Brand?             @relation(fields: [brandId], references: [id])
  category          Category?          @relation(fields: [categoryId], references: [id])
  tenant            Tenant             @relation(fields: [tenantId], references: [id])
  saleItems         SaleItem[]
  quoteItems        QuoteItem[]
  stockMovements    StockMovement[]
  transferItems     TransferItem[]
  purchaseItems     PurchaseItem[]
  priceTiers        ProductPriceTier[]
  ecommerceMappings ProductMapping[]

  @@unique([barcode, tenantId])
  @@index([tenantId])
  @@index([categoryId])
  @@index([brandId])
  @@index([supplierId])
}

model ProductPriceTier {
  id          String   @id @default(uuid())
  productId   String
  minQuantity Int // Cantidad mínima para activar este precio (mínimo 2)
  unitPrice   Int // Precio unitario en pesos CLP — debe ser < product.price
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
  product     Product  @relation(fields: [productId], references: [id], onDelete: Cascade)

  @@unique([productId, minQuantity])
}

model Inventory {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  quantity  Decimal  @default(0) @db.Decimal(10, 3)
  minStock  Int      @default(0)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
  @@index([branchId])
  @@index([productId])
  @@map("InventoryLevel")
}

model Transfer {
  id             String         @id @default(uuid())
  originBranchId String
  destBranchId   String
  status         TransferStatus @default(PENDING)
  requestedById  String
  processedById  String?
  createdAt      DateTime       @default(now())
  updatedAt      DateTime       @updatedAt
  note           String?

  originBranch      Branch         @relation("OriginBranch", fields: [originBranchId], references: [id])
  destinationBranch Branch         @relation("DestinationBranch", fields: [destBranchId], references: [id])
  requestedBy       User           @relation("RequestedBy", fields: [requestedById], references: [id])
  processedBy       User?          @relation("ProcessedBy", fields: [processedById], references: [id])
  items             TransferItem[]
}

model TransferItem {
  id         String  @id @default(uuid())
  transferId String
  productId  String
  quantity   Decimal @db.Decimal(10, 3)

  transfer Transfer @relation(fields: [transferId], references: [id])
  product  Product  @relation(fields: [productId], references: [id])
}

enum TransferStatus {
  PENDING
  APPROVED
  REJECTED
  COMPLETED
  CANCELLED
}

model Sale {
  id                 String     @id @default(uuid())
  total              Float
  discountAmount     Float      @default(0)
  tenantId           String
  branchId           String
  userId             String?
  cashShiftId        String?
  customerId         String?
  quoteId            String?
  status             String     @default("COMPLETED") // COMPLETED, PRE_SALE
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  dteFolio           Int?
  dteStatus          String     @default("PENDING")
  dteType            Int        @default(39)
  dtePdfUrl          String?
  originalSaleId     String? // Para Nota de Crédito: referencia a la venta original que se anula
  internalReceiptUrl String?
  branch             Branch     @relation(fields: [branchId], references: [id])
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  user               User?      @relation(fields: [userId], references: [id])
  cashShift          CashShift? @relation(fields: [cashShiftId], references: [id])
  customer           Customer?  @relation(fields: [customerId], references: [id])
  quote              Quote?     @relation(fields: [quoteId], references: [id])
  credit             Credit?
  items              SaleItem[]
  payments           Payment[]

  @@index([tenantId])
  @@index([branchId])
  @@index([createdAt])
}

model SaleItem {
  id             String  @id @default(uuid())
  saleId         String
  productId      String
  quantity       Decimal @db.Decimal(10, 3)
  price          Float
  discountAmount Float   @default(0)
  product        Product @relation(fields: [productId], references: [id])
  sale           Sale    @relation(fields: [saleId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  amount        Float
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id])
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

enum TransbankStatus {
  PENDING
  APPROVED
  REJECTED
  ERROR
  CANCELLED
  TIMEOUT
}

model PaymentTransaction {
  id                String          @id @default(uuid())
  tenantId          String
  branchId          String
  saleId            String?
  orderId           String          @unique
  amount            Int
  status            TransbankStatus @default(PENDING)
  provider          String          @default("TRANSBANK_POS")
  responseCode      Int?
  authorizationCode String?
  responseMessage   String?
  cardType          String?
  lastFourDigits    String?
  transactionDate   DateTime?
  installments      Int?
  rawResponse       Json?
  createdAt         DateTime        @default(now())
  updatedAt         DateTime        @updatedAt

  tenant Tenant @relation(fields: [tenantId], references: [id])
  branch Branch @relation(fields: [branchId], references: [id])

  @@index([tenantId, createdAt(sort: Desc)])
  @@index([branchId])
}

model DteConfig {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  liorenToken    String?
  liorenLogo     String?
  dteResolution  String?
  resolutionDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

enum UnitType {
  UNIT
  WEIGHT
}

model CashShift {
  id             String          @id @default(uuid())
  branchId       String
  branch         Branch          @relation(fields: [branchId], references: [id])
  openedById     String
  openedBy       User            @relation("OpenedShifts", fields: [openedById], references: [id])
  closedById     String?
  closedBy       User?           @relation("ClosedShifts", fields: [closedById], references: [id])
  startTime      DateTime        @default(now())
  endTime        DateTime?
  initialAmount  Decimal         @db.Decimal(10, 2)
  finalAmount    Decimal?        @db.Decimal(10, 2)
  expectedAmount Decimal?        @db.Decimal(10, 2)
  difference     Decimal?        @db.Decimal(10, 2)
  status         String          @default("OPEN")
  metadata       Json?
  sales          Sale[]
  creditPayments CreditPayment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt

  @@index([branchId])
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  rut       String
  giro      String?
  address   String?
  comuna    String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sales     Sale[]
  quotes    Quote[]
  credits   Credit[]

  @@unique([rut, tenantId])
  @@index([tenantId])
}

enum QuoteStatus {
  DRAFT
  SENT
  ACCEPTED
  REJECTED
}

model Quote {
  id         String      @id @default(uuid())
  number     String? // e.g. QT-0001
  tenantId   String
  customerId String?
  userId     String?
  subtotal   Float       @default(0)
  tax        Float       @default(0)
  total      Float       @default(0)
  includeIva Boolean     @default(true)
  status     QuoteStatus @default(DRAFT)
  issueDate  DateTime    @default(now())
  validUntil DateTime?
  notes      String?     @db.Text
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt

  items    QuoteItem[]
  tenant   Tenant      @relation(fields: [tenantId], references: [id])
  customer Customer?   @relation(fields: [customerId], references: [id])
  user     User?       @relation(fields: [userId], references: [id])
  sales    Sale[]

  @@index([tenantId])
}

model QuoteItem {
  id          String  @id @default(uuid())
  quoteId     String
  productId   String
  productName String? // Keep name for history
  quantity    Decimal @db.Decimal(10, 3)
  price       Float
  discount    Float   @default(0)
  total       Float

  quote   Quote   @relation(fields: [quoteId], references: [id])
  product Product @relation(fields: [productId], references: [id])
}

model Credit {
  id          String          @id @default(uuid())
  tenantId    String
  customerId  String
  saleId      String?         @unique
  totalAmount Float
  balance     Float
  status      String          @default("OPEN") // OPEN, PAID
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  sale        Sale?           @relation(fields: [saleId], references: [id])
  payments    CreditPayment[]

  @@index([tenantId])
  @@index([customerId])
}

model CreditPayment {
  id            String     @id @default(uuid())
  creditId      String
  amount        Float
  paymentMethod String
  cashShiftId   String?
  createdAt     DateTime   @default(now())
  credit        Credit     @relation(fields: [creditId], references: [id])
  cashShift     CashShift? @relation(fields: [cashShiftId], references: [id])
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  branchId  String
  quantity  Decimal      @db.Decimal(10, 3) // Positive for IN, Negative for OUT
  type      MovementType
  reference String? // e.g. "SALE-123" or "Initial Stock"
  balance   Decimal      @db.Decimal(10, 3) // Calculated balance after this movement
  createdAt DateTime     @default(now())
  userId    String?

  product Product @relation(fields: [productId], references: [id])
  branch  Branch  @relation(fields: [branchId], references: [id])
  user    User?   @relation(fields: [userId], references: [id])

  @@index([branchId])
  @@index([productId])
  @@index([createdAt])
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL
}

model Plan {
  id              String       @id @default(uuid())
  name            String
  description     String?
  price           Int
  features        Json? // Array of benefit strings
  maxUsers        Int
  maxProducts     Int          @default(500)
  maxStorage      Int          @default(0)
  isRecommended   Boolean      @default(false)
  isVisible       Boolean      @default(true)
  enabledFeatures Json? // Feature flags: enableEcommerce, enableTransbank, etc.
  createdAt       DateTime     @default(now())
  updatedAt       DateTime     @updatedAt
  tenants         Tenant[]
  planModules     PlanModule[]
}

model SystemLog {
  id        String   @id @default(uuid())
  level     String // ERROR, WARNING, INFO
  message   String
  context   Json?
  tenantId  String?
  tenant    Tenant?  @relation(fields: [tenantId], references: [id])
  createdAt DateTime @default(now())

  @@index([tenantId])
}

model Announcement {
  id        String   @id @default(uuid())
  title     String
  content   String
  type      String // INFO, WARNING
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// ============================================================
// MÓDULO PROVEEDORES Y COMPRAS
// ============================================================

enum PurchaseStatus {
  PENDING
  COMPLETED
  CANCELLED
}

model Supplier {
  id        String     @id @default(uuid())
  name      String
  rut       String?
  email     String?
  phone     String?
  address   String?
  tenantId  String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  tenant    Tenant     @relation(fields: [tenantId], references: [id])
  purchases Purchase[]
  products  Product[]

  @@index([tenantId])
}

model Purchase {
  id          String         @id @default(uuid())
  date        DateTime       @default(now())
  totalAmount Float          @default(0)
  status      PurchaseStatus @default(COMPLETED)
  supplierId  String?
  branchId    String
  tenantId    String
  notes       String?        @db.Text
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  supplier    Supplier?      @relation(fields: [supplierId], references: [id])
  branch      Branch         @relation(fields: [branchId], references: [id])
  tenant      Tenant         @relation(fields: [tenantId], references: [id])
  items       PurchaseItem[]

  @@index([tenantId])
  @@index([branchId])
}

model PurchaseItem {
  id         String   @id @default(uuid())
  purchaseId String
  productId  String
  quantity   Decimal  @db.Decimal(10, 3)
  costPrice  Float // precio de costo unitario al momento de la compra
  purchase   Purchase @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  product    Product  @relation(fields: [productId], references: [id])
}

// ============================================================
// MÓDULO INTEGRACIONES ECOMMERCE (Shopify / WooCommerce)
// ============================================================

enum EcommercePlatform {
  SHOPIFY
  WOOCOMMERCE
}

enum SyncStatus {
  IDLE
  SYNCING
  SUCCESS
  ERROR
  PARTIAL
}

enum SyncDirection {
  PUSH
  PULL
}

enum SyncEntityType {
  PRODUCT
  INVENTORY
  ORDER
  CUSTOMER
  FULL
}

enum EcommerceOrderStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
  IGNORED
}

model EcommerceConnection {
  id       String            @id @default(uuid())
  tenantId String
  platform EcommercePlatform
  name     String

  // Shopify
  shopDomain    String?
  accessToken   String?
  locationId    String?
  webhookSecret String?

  // WooCommerce
  siteUrl        String?
  consumerKey    String?
  consumerSecret String?

  // Opciones de sync
  syncProducts   Boolean @default(true)
  syncInventory  Boolean @default(true)
  syncOrders     Boolean @default(true)
  syncCustomers  Boolean @default(false)
  autoCreateSale Boolean @default(false)

  isActive   Boolean    @default(true)
  lastSyncAt DateTime?
  syncStatus SyncStatus @default(IDLE)
  lastError  String?

  tenant   Tenant              @relation(fields: [tenantId], references: [id])
  mappings ProductMapping[]
  webhooks RegisteredWebhook[]
  orders   EcommerceOrder[]
  syncLogs SyncLog[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model ProductMapping {
  id                String  @id @default(uuid())
  connectionId      String
  nexoposProductId  String
  externalId        String
  externalVariantId String?

  lastPushedAt DateTime?
  lastPulledAt DateTime?

  connection EcommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  product    Product             @relation(fields: [nexoposProductId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, nexoposProductId])
  @@unique([connectionId, externalId])
}

model RegisteredWebhook {
  id           String  @id @default(uuid())
  connectionId String
  topic        String
  externalId   String
  callbackUrl  String
  isActive     Boolean @default(true)

  connection EcommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
}

model EcommerceOrder {
  id             String               @id @default(uuid())
  connectionId   String
  tenantId       String
  externalId     String
  externalNumber String?
  platform       EcommercePlatform
  status         EcommerceOrderStatus @default(PENDING)
  rawData        Json
  processedAt    DateTime?
  saleId         String?
  errorMessage   String?

  connection EcommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)
  tenant     Tenant              @relation(fields: [tenantId], references: [id])

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([connectionId, externalId])
}

model SyncLog {
  id           String         @id @default(uuid())
  connectionId String
  tenantId     String
  entityType   SyncEntityType
  direction    SyncDirection
  status       SyncStatus
  total        Int            @default(0)
  synced       Int            @default(0)
  failed       Int            @default(0)
  errors       Json?
  durationMs   Int?

  connection EcommerceConnection @relation(fields: [connectionId], references: [id], onDelete: Cascade)

  startedAt   DateTime  @default(now())
  completedAt DateTime?
}

model TenantSettings {
  id       String @id @default(uuid())
  tenantId String @unique
  tenant   Tenant @relation(fields: [tenantId], references: [id])

  // --- Módulos DTE (SII chileno) ---
  enableBoletaDte       Boolean @default(false)
  enableFacturaDte      Boolean @default(false)
  enableGuiaDespachoDte Boolean @default(false)
  enableNotaCreditoDte  Boolean @default(false)

  // --- Límites de Recursos ---
  maxBranches  Int @default(1)
  maxRegisters Int @default(1)
  maxUsers     Int @default(3)

  // --- Permisos Especiales ---
  canHardDelete Boolean @default(false)

  // --- Feature Flags (control por SuperAdmin) ---
  enableEcommerce    Boolean @default(true)
  enableTransbank    Boolean @default(false)
  enableIntegrations Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LandingConfig {
  id        String   @id @default("singleton")
  data      Json
  updatedAt DateTime @updatedAt
}

// ============================================================
// MÓDULOS SAAS (APROVISIONAMIENTO)
// ============================================================

model Module {
  id          String  @id @default(uuid())
  code        String  @unique
  name        String
  description String?
  isActive    Boolean @default(true)
  price       Int     @default(0)

  planModules  PlanModule[]
  tenantAddons TenantModuleAddon[]
}

model PlanModule {
  id       String @id @default(uuid())
  planId   String
  moduleId String

  plan   Plan   @relation(fields: [planId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([planId, moduleId])
}

model TenantModuleAddon {
  id       String @id @default(uuid())
  tenantId String
  moduleId String

  tenant Tenant @relation(fields: [tenantId], references: [id], onDelete: Cascade)
  module Module @relation(fields: [moduleId], references: [id], onDelete: Cascade)

  @@unique([tenantId, moduleId])
}

model SystemNotification {
  id        String   @id @default(uuid())
  title     String
  message   String
  type      String   // 'CHAT', 'REGISTRATION', 'SYSTEM'
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model ChatSession {
  id          String   @id @default(uuid())
  visitorId   String   // Can be a temporary UUID or an authenticated user ID
  visitorName String   @default("Visitante Anónimo")
  status      String   @default("ACTIVE") // ACTIVE, CLOSED
  messages    ChatMessage[]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model ChatMessage {
  id            String      @id @default(uuid())
  chatSessionId String
  sender        String      // VISITOR, ADMIN, BOT
  content       String
  createdAt     DateTime    @default(now())
  chatSession   ChatSession @relation(fields: [chatSessionId], references: [id], onDelete: Cascade)

  @@index([chatSessionId])
}
