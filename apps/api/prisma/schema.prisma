generator client {
  provider = "prisma-client-js"
  engineType = "library"
}


datasource db {
  provider = "postgresql"
}

model Tenant {
  id         String     @id @default(uuid())
  name       String
  rut        String?
  giro       String?
  address    String?
  createdAt  DateTime   @default(now())
  updatedAt  DateTime   @updatedAt
  branches   Branch[]
  brands     Brand[]
  categories Category[]
  dteConfig  DteConfig?
  products   Product[]
  sales      Sale[]
  users      User[]
  customers  Customer[]
  quotes     Quote[]
  credits    Credit[]
}

model Branch {
  id        String           @id @default(uuid())
  name      String
  tenantId  String
  tenant    Tenant           @relation(fields: [tenantId], references: [id])
  inventory InventoryLevel[]
  sales     Sale[]
  users     User[]
  cashShifts CashShift[]
  stockMovements StockMovement[]
}

model User {
  id        String   @id @default(uuid())
  email     String   @unique
  name      String?
  password  String?
  role      UserRole @default(USER)
  tenantId  String
  branchId  String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  sales     Sale[]
  branch    Branch?  @relation(fields: [branchId], references: [id])
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  stockMovements StockMovement[]
  shiftsOpened CashShift[] @relation("OpenedShifts")
  shiftsClosed CashShift[] @relation("ClosedShifts")
}

enum UserRole {
  ADMIN
  CASHIER
  USER
}

model Category {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([name, tenantId])
}

model Brand {
  id        String    @id @default(uuid())
  name      String
  tenantId  String
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
  tenant    Tenant    @relation(fields: [tenantId], references: [id])
  products  Product[]

  @@unique([name, tenantId])
}

model Product {
  id         String           @id @default(uuid())
  name       String
  sku        String?
  price      Int              @default(0)
  tenantId   String
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  barcode    String?
  brandId    String?
  categoryId String?
  costPrice  Int              @default(0)
  image      String?
  isActive   Boolean          @default(true)
  minStock   Int              @default(0)
  unitType   UnitType         @default(UNIT)
  inventory  InventoryLevel[]
  brand      Brand?           @relation(fields: [brandId], references: [id])
  category   Category?        @relation(fields: [categoryId], references: [id])
  tenant     Tenant           @relation(fields: [tenantId], references: [id])
  saleItems  SaleItem[]
  quoteItems QuoteItem[]
  stockMovements StockMovement[]

  @@unique([barcode, tenantId])
}

model InventoryLevel {
  id        String   @id @default(uuid())
  productId String
  branchId  String
  quantity  Decimal  @default(0) @db.Decimal(10, 3)
  updatedAt DateTime @updatedAt
  branch    Branch   @relation(fields: [branchId], references: [id])
  product   Product  @relation(fields: [productId], references: [id])

  @@unique([productId, branchId])
}

model Sale {
  id                 String     @id @default(uuid())
  total              Float
  tenantId           String
  branchId           String
  userId             String?
  cashShiftId        String?
  customerId         String?
  quoteId            String?
  status             String     @default("COMPLETED") // COMPLETED, PRE_SALE
  createdAt          DateTime   @default(now())
  updatedAt          DateTime   @updatedAt
  dteFolio           Int?
  dteStatus          String     @default("PENDING")
  dteType            Int        @default(39)
  dtePdfUrl          String?
  internalReceiptUrl String?
  branch             Branch     @relation(fields: [branchId], references: [id])
  tenant             Tenant     @relation(fields: [tenantId], references: [id])
  user               User?      @relation(fields: [userId], references: [id])
  cashShift          CashShift? @relation(fields: [cashShiftId], references: [id])
  customer           Customer?  @relation(fields: [customerId], references: [id])
  quote              Quote?     @relation(fields: [quoteId], references: [id])
  credit             Credit?
  items              SaleItem[]
  payments           Payment[]
}

model SaleItem {
  id        String  @id @default(uuid())
  saleId    String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  price     Float
  product   Product @relation(fields: [productId], references: [id])
  sale      Sale    @relation(fields: [saleId], references: [id])
}

model Payment {
  id            String        @id @default(uuid())
  saleId        String
  amount        Float
  paymentMethod PaymentMethod
  createdAt     DateTime      @default(now())
  sale          Sale          @relation(fields: [saleId], references: [id])
}

enum PaymentMethod {
  EFECTIVO
  DEBITO
  CREDITO
  TRANSFERENCIA
}

model DteConfig {
  id             String    @id @default(uuid())
  tenantId       String    @unique
  liorenToken    String?
  liorenLogo     String?
  dteResolution  String?
  resolutionDate DateTime?
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt
  tenant         Tenant    @relation(fields: [tenantId], references: [id])
}

enum UnitType {
  UNIT
  WEIGHT
}

model CashShift {
  id            String    @id @default(uuid())
  branchId      String
  branch        Branch    @relation(fields: [branchId], references: [id])
  openedById    String
  openedBy      User      @relation("OpenedShifts", fields: [openedById], references: [id])
  closedById    String?
  closedBy      User?     @relation("ClosedShifts", fields: [closedById], references: [id])
  startTime     DateTime  @default(now())
  endTime       DateTime?
  initialAmount Decimal   @db.Decimal(10, 2)
  finalAmount   Decimal?  @db.Decimal(10, 2)
  expectedAmount Decimal? @db.Decimal(10, 2)
  difference    Decimal?  @db.Decimal(10, 2)
  status        String    @default("OPEN")
  metadata      Json?
  sales          Sale[]
  creditPayments CreditPayment[]
  createdAt      DateTime        @default(now())
  updatedAt      DateTime        @updatedAt
}

model Customer {
  id        String   @id @default(uuid())
  tenantId  String
  name      String
  rut       String
  giro      String?
  address   String?
  comuna    String?
  email     String?
  phone     String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  tenant    Tenant   @relation(fields: [tenantId], references: [id])
  sales     Sale[]
  quotes    Quote[]
  credits   Credit[]
  
  @@unique([rut, tenantId])
}

model Quote {
  id         String      @id @default(uuid())
  tenantId   String
  customerId String?
  total      Float
  status     String      @default("DRAFT") // DRAFT, ISSUED, CONVERTED
  createdAt  DateTime    @default(now())
  updatedAt  DateTime    @updatedAt
  expiryDate DateTime?
  items      QuoteItem[]
  tenant     Tenant      @relation(fields: [tenantId], references: [id])
  customer   Customer?   @relation(fields: [customerId], references: [id])
  sales      Sale[]
}

model QuoteItem {
  id        String  @id @default(uuid())
  quoteId   String
  productId String
  quantity  Decimal @db.Decimal(10, 3)
  price     Float
  quote     Quote   @relation(fields: [quoteId], references: [id])
  product   Product @relation(fields: [productId], references: [id])
}

model Credit {
  id          String          @id @default(uuid())
  tenantId    String
  customerId  String
  saleId      String?         @unique
  totalAmount Float
  balance     Float
  status      String          @default("OPEN") // OPEN, PAID
  dueDate     DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt
  tenant      Tenant          @relation(fields: [tenantId], references: [id])
  customer    Customer        @relation(fields: [customerId], references: [id])
  sale        Sale?           @relation(fields: [saleId], references: [id])
  payments    CreditPayment[]
}

model CreditPayment {
  id            String    @id @default(uuid())
  creditId      String
  amount        Float
  paymentMethod String
  cashShiftId   String?
  createdAt     DateTime  @default(now())
  credit        Credit    @relation(fields: [creditId], references: [id])
  cashShift     CashShift? @relation(fields: [cashShiftId], references: [id])
}

model StockMovement {
  id        String       @id @default(uuid())
  productId String
  branchId  String
  quantity  Decimal      @db.Decimal(10, 3) // Positive for IN, Negative for OUT
  type      MovementType
  reference String?      // e.g. "SALE-123" or "Initial Stock"
  balance   Decimal      @db.Decimal(10, 3) // Calculated balance after this movement
  createdAt DateTime     @default(now())
  userId    String?

  product   Product      @relation(fields: [productId], references: [id])
  branch    Branch       @relation(fields: [branchId], references: [id])
  user      User?        @relation(fields: [userId], references: [id])
}

enum MovementType {
  SALE
  PURCHASE
  ADJUSTMENT
  RETURN
  TRANSFER_IN
  TRANSFER_OUT
  INITIAL
}
