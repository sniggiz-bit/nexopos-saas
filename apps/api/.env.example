# Database
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/nexopos?schema=public"

# JWT Secret (cambiar en producción)
JWT_SECRET="tu-secreto-super-seguro-cambiar-en-produccion"
JWT_EXPIRES_IN="7d"

# Node Environment
NODE_ENV="production"

# API Port
PORT=3000

# Super Admin Credentials (para seed inicial)
SUPER_ADMIN_EMAIL="admin@nexopos.cl"
SUPER_ADMIN_PASSWORD="Admin123!"

# CORS Origins (separados por coma)
CORS_ORIGINS="http://localhost:3001,https://nexopos.cl,https://www.nexopos.cl"
