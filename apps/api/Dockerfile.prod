# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace files
COPY package.json package-lock.json ./

# Copy api package.json
COPY apps/api/package.json ./apps/api/

# Install dependencies
RUN npm install

# Copy the rest of the application
COPY apps/api ./apps/api
# COPY tsconfig.json ./

# Generate Prisma Client
WORKDIR /app/apps/api
RUN npx prisma generate

# Build the application with explicit verification
# The key here is to ensure nest-cli.json has the right config
RUN npm run build && \
    echo "=== Checking if dist was created ===" && \
    ls -la && \
    if [ ! -d "dist" ]; then \
    echo "ERROR: dist directory was not created!" && \
    echo "Attempting manual tsc build..." && \
    npx tsc -p tsconfig.build.json && \
    ls -la; \
    fi && \
    echo "=== Contents of dist directory ===" && \
    ls -la dist/ && \
    echo "=== Build verification complete ==="

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy only necessary files from builder
COPY --from=builder /app/package.json /app/package-lock.json ./
# Copy root node_modules (where hoisted dependencies live)
COPY --from=builder /app/node_modules ./node_modules
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# Verify dist was copied
RUN echo "=== Verifying dist in runner stage ===" && \
    ls -la /app/apps/api/ && \
    ls -la /app/apps/api/dist/

WORKDIR /app/apps/api

# Install wget for healthcheck (usually included in alpine, but to be sure)
# Actually, alpine has wget by default.

EXPOSE 3000

# Healthcheck using wget
HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
    CMD wget --no-verbose --tries=1 --spider http://localhost:3000 || exit 1

# Run migrations and then start the app
CMD ["sh", "-c", "npx prisma migrate deploy && node dist/src/main.js"]
