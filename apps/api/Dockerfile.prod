# ─── Build stage: compile TypeScript ─────────────────────────────────────────
FROM node:20-alpine AS builder

# Install OpenSSL so Prisma can detect libssl at generate time
RUN apk add --no-cache openssl

WORKDIR /app

# Copy workspace manifests first (better layer caching)
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install ALL deps (dev + prod) needed for build
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci

# Copy source code
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json ./apps/api/tsconfig.build.json
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

# Create nest-cli.json (required by nest build)
RUN echo '{"$schema":"https://json.schemastore.org/nest-cli","collection":"@nestjs/schematics","sourceRoot":"src","compilerOptions":{"deleteOutDir":true,"webpack":false,"tsConfigPath":"tsconfig.build.json"}}' > nest-cli.json

# Generate Prisma client for Alpine (linux-musl-openssl-3.0.x)
RUN npm exec -- prisma generate

# Compile TypeScript to dist/
RUN NODE_OPTIONS=--max-old-space-size=512 npm run build

# ─── Runner stage: production image ──────────────────────────────────────────
FROM node:20-alpine AS runner

# Install OpenSSL so Prisma engine can load libssl at runtime
RUN apk add --no-cache openssl

WORKDIR /app

ENV NODE_ENV=production

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install production dependencies WITH scripts so native packages like bcrypt compile
# @prisma/client postinstall will attempt generate without schema — exits gracefully (code 0)
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci --omit=dev

# Install prisma CLI globally for migrate deploy + generate
RUN npm install -g prisma@5.22.0

# Copy compiled app from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy Prisma schema and shared package
COPY apps/api/prisma ./apps/api/prisma
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

# Regenerate Prisma client HERE in the runner with the correct Alpine binary
# This overwrites whatever @prisma/client's postinstall produced
RUN prisma generate

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api || exit 1

# Retry loop: wait until postgres is ready before migrating, then start the server
CMD ["sh", "-c", "until prisma migrate deploy 2>&1; do echo 'DB not ready, retrying in 3s...'; sleep 3; done && node dist/main.js"]
