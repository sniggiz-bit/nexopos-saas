# ─── Build stage: compile TypeScript ─────────────────────────────────────────
FROM node:20-alpine AS builder

# OpenSSL required by Prisma schema engine (used by prisma generate + migrate)
RUN apk add --no-cache openssl

WORKDIR /app

# Copy workspace manifests first (better layer caching)
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install ALL deps (dev + prod) needed for build
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci

# Copy source code
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json ./apps/api/tsconfig.build.json
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

# Create nest-cli.json (required by nest build)
RUN echo '{"$schema":"https://json.schemastore.org/nest-cli","collection":"@nestjs/schematics","sourceRoot":"src","compilerOptions":{"deleteOutDir":true,"webpack":false,"tsConfigPath":"tsconfig.build.json"}}' > nest-cli.json

# Generate Prisma client types (needed for TypeScript compilation)
RUN npm exec -- prisma generate

# Compile TypeScript to dist/
RUN NODE_OPTIONS=--max-old-space-size=512 npm run build

# ─── Runner stage: production image ──────────────────────────────────────────
FROM node:20-alpine AS runner

# OpenSSL required by Prisma schema engine (used by prisma migrate deploy)
RUN apk add --no-cache openssl

WORKDIR /app

ENV NODE_ENV=production

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install production dependencies (scripts enabled so native modules like bcrypt compile)
# prisma CLI included (it's a production dep) — used for prisma migrate deploy
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci --omit=dev

# Copy compiled app from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy Prisma schema and shared package
COPY apps/api/prisma ./apps/api/prisma
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

# Generate Prisma client in the runner for correct Alpine binary target.
# The pg adapter bypasses the Rust query engine for queries,
# but the generated client types are still needed.
RUN /app/node_modules/.bin/prisma generate

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api || exit 1

# Retry loop: wait for DB to accept connections before migrating, then start server
CMD ["sh", "-c", "until /app/node_modules/.bin/prisma migrate deploy 2>&1; do echo 'DB not ready, retrying in 3s...'; sleep 3; done && node dist/main.js"]
