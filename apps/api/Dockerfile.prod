# Build stage — compile TypeScript + generate Prisma client
FROM node:20-alpine AS builder

WORKDIR /app

# Copy all workspace manifests for correct dependency resolution
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install all dependencies (NODE_OPTIONS limits heap to avoid OOM on low-RAM servers)
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci

# Copy sources needed for Prisma generation + TypeScript compilation
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json ./apps/api/tsconfig.build.json
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api
RUN echo '{"$$schema": "https://json.schemastore.org/nest-cli", "collection": "@nestjs/schematics", "sourceRoot": "src", "compilerOptions": { "deleteOutDir": true, "webpack": false, "tsConfigPath": "tsconfig.build.json" }}' > nest-cli.json
RUN npm exec -- prisma generate
RUN cp -R /app/node_modules/.prisma /app/prisma_generated || cp -R /app/apps/api/node_modules/.prisma /app/prisma_generated
RUN NODE_OPTIONS=--max-old-space-size=512 npm run build

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install only production dependencies
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci --omit=dev
RUN npm install -g prisma@5.22.0

# Copy compiled dist from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy Prisma files and generated client from builder
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/prisma.config.ts ./apps/api/prisma.config.ts
COPY --from=builder /app/prisma_generated ./node_modules/.prisma

# Copy shared package source (needed at runtime for workspace resolution)
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=40s \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api || exit 1

CMD ["sh", "-c", "prisma migrate deploy && node dist/main.js"]
