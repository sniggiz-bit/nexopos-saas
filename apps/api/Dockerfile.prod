# Build stage
FROM node:20-alpine AS builder

WORKDIR /app

# Copy root workspace files
COPY package.json package-lock.json ./

# Copy api package.json
COPY apps/api/package.json ./apps/api/

# Install dependencies (using npm ci for faster/reproducible builds)
RUN npm ci

# Copy the rest of the application
COPY apps/api ./apps/api
COPY tsconfig.json ./

# Generate Prisma Client
WORKDIR /app/apps/api
RUN npx prisma generate

# Build the application with explicit verification
# The key here is to ensure nest-cli.json has the right config
RUN npm run build && \
    echo "=== Checking if dist was created ===" && \
    ls -la && \
    if [ ! -d "dist" ]; then \
    echo "ERROR: dist directory was not created!" && \
    echo "Attempting manual tsc build..." && \
    npx tsc -p tsconfig.build.json && \
    ls -la; \
    fi && \
    echo "=== Contents of dist directory ===" && \
    ls -la dist/ && \
    echo "=== Build verification complete ==="

# Production stage
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy only necessary files from builder
COPY --from=builder /app/package.json /app/package-lock.json ./
COPY --from=builder /app/apps/api/package.json ./apps/api/
COPY --from=builder /app/apps/api/dist ./apps/api/dist
COPY --from=builder /app/apps/api/node_modules ./apps/api/node_modules
COPY --from=builder /app/apps/api/prisma ./apps/api/prisma

# Verify dist was copied
RUN echo "=== Verifying dist in runner stage ===" && \
    ls -la /app/apps/api/ && \
    ls -la /app/apps/api/dist/

WORKDIR /app/apps/api

EXPOSE 3000

CMD ["node", "dist/src/main.js"]
