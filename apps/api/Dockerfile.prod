# ─── Build stage: compile TypeScript ─────────────────────────────────────────
FROM node:20-alpine AS builder

WORKDIR /app

# Copy workspace manifests first (better layer caching)
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install ALL deps (dev + prod) needed for build
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci

# Copy source code
COPY apps/api/prisma ./apps/api/prisma
COPY apps/api/src ./apps/api/src
COPY apps/api/tsconfig.json ./apps/api/tsconfig.json
COPY apps/api/tsconfig.build.json ./apps/api/tsconfig.build.json
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

# Create nest-cli.json (required by nest build)
RUN echo '{"$schema":"https://json.schemastore.org/nest-cli","collection":"@nestjs/schematics","sourceRoot":"src","compilerOptions":{"deleteOutDir":true,"webpack":false,"tsConfigPath":"tsconfig.build.json"}}' > nest-cli.json

# Generate Prisma client (builder is also Alpine, so native = linux-musl-openssl-3.0.x)
RUN npm exec -- prisma generate

# Compile TypeScript to dist/
RUN NODE_OPTIONS=--max-old-space-size=512 npm run build

# ─── Runner stage: production image ──────────────────────────────────────────
FROM node:20-alpine AS runner

WORKDIR /app

ENV NODE_ENV=production

# Copy workspace manifests
COPY package.json package-lock.json ./
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY packages/shared/package.json ./packages/shared/

# Install production dependencies only
# Note: @prisma/client postinstall will attempt prisma generate but prisma CLI
# is not available yet — that's fine, we regenerate below with the schema.
RUN NODE_OPTIONS=--max-old-space-size=512 npm ci --omit=dev --ignore-scripts

# Install prisma CLI globally so migrate deploy and generate work at runtime
RUN npm install -g prisma@5.22.0

# Copy compiled app from builder
COPY --from=builder /app/apps/api/dist ./apps/api/dist

# Copy Prisma schema and shared package
COPY apps/api/prisma ./apps/api/prisma
COPY packages/shared ./packages/shared

WORKDIR /app/apps/api

# Generate the Prisma client HERE in the runner with the correct Alpine binary
# This is the definitive fix: no more copying .prisma from builder
RUN prisma generate

EXPOSE 3000

HEALTHCHECK --interval=30s --timeout=10s --retries=3 --start-period=60s \
    CMD wget --no-verbose --tries=1 --spider http://127.0.0.1:3000/api || exit 1

CMD ["sh", "-c", "set -e && echo '→ Running DB migrations...' && prisma migrate deploy && echo '→ Starting NestJS API...' && node dist/main.js"]
